# No copies variables de proyectos anteriores. Presentación sin datos por defecto.
NEXT_PUBLIC_APP_MODE=preview
APP_MODE=preview

# Aplicación web del NUEVO proyecto Firebase de Salvador Alvarado.
# PROJECT_ID y EXPECTED_PROJECT_ID deben ser exactamente el mismo ID nuevo.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_EXPECTED_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cuenta de servicio del MISMO proyecto. Solo servidor; nunca usar NEXT_PUBLIC_.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_STORAGE_BUCKET=

# Gmail dedicado a este programa y contraseña de aplicación (no contraseña normal).
EMAIL_USER=
EMAIL_APP_PASSWORD=

# URL NUEVA de Vercel, sin barra final. localhost solo para pruebas locales.
APP_URL=http://localhost:3000
EMAIL_SIGNATURE_URL=

# Completar con datos confirmados del instituto de Salvador Alvarado.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
# Si no se han confirmado, las redes se ocultan.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
